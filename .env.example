# Copiez ce fichier vers .env.local et remplacez chaque valeur par votre configuration.
# Profil V1 recommandé. Le profil "full" réactive les validations strictes des intégrations optionnelles.
PRODUCT_PROFILE="v1"
DATABASE_URL="postgresql://ticketing:mot-de-passe@localhost:5432/ticket_db?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="remplacer-par-un-secret-long-et-aleatoire"
MICROSOFT_ENTRA_ID_CLIENT_ID="identifiant-de-l-application"
MICROSOFT_ENTRA_ID_CLIENT_SECRET="valeur-du-secret"
MICROSOFT_ENTRA_ID_TENANT_ID="identifiant-du-tenant"
# Application Entra distincte, réservée à l'envoi des notifications par Microsoft Graph.
MICROSOFT_MAIL_TENANT_ID=""
MICROSOFT_MAIL_CLIENT_ID=""
MICROSOFT_MAIL_CLIENT_SECRET=""
MICROSOFT_MAIL_SENDER=""
ALLOWED_EMAIL_DOMAIN="bios-expertise.com"
ADMIN_EMAILS="votre.adresse@bios-expertise.com"
CRON_SECRET="remplacer-par-un-secret-cron"
PERFORMANCE_SLOW_OPERATION_MS="750"
# Inactifs en V1 : Redis, livraison outbox, e-mail Graph et Web Push peuvent rester absents.
CACHE_ENABLED="false"
REDIS_REST_URL=""
REDIS_REST_TOKEN=""
SLA_MONITOR_BATCH_SIZE="100"
TICKET_FTS_ENABLED="true"
OUTBOX_BATCH_SIZE="25"
OUTBOX_DELIVERY_URL=""
OUTBOX_DELIVERY_TOKEN=""
# Lecture des pièces jointes historiques uniquement en V1. En production, les deux
# valeurs sont requises ensemble pour accéder au stockage durable privé.
PRIVATE_STORAGE_URL=""
PRIVATE_STORAGE_TOKEN=""
RUN_DB_TESTS="0"
# Web Push : la clé privée reste exclusivement côté serveur.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""
