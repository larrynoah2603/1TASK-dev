{
  "name": "ticketing-interne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "next dev",
    "predev": "prisma generate",
    "postinstall": "prisma generate",
    "build": "next build",
    "prebuild": "npm run env:check && npm run clean:next && prisma generate",
    "prestart": "npm run env:check -- production",
    "start": "next start",
    "lint": "eslint .",
    "env:check": "tsx config/validate-env.ts",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean:next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "pretypecheck": "npm run clean:next",
    "typecheck": "prisma generate && tsc --noEmit",
    "validate": "npm run db:generate && npm test && npm run lint && npm run typecheck && npx prisma validate && npm run build"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
